# Copy to deploy/.env, chmod 600, and supply a unique password.
POSTGRES_PASSWORD=

# Optional overrides: uncomment and set a value. Empty keeps the default.
# Gateway defaults live in cmd/gateway/config.go; deployment defaults live in Compose.
# See docs/manual-testing.md for values and units.

# Host paths and published ports. Internal service addresses stay in Compose.
# LLMGATE_MODEL_PATH=
# GATEWAY_PORT=
# POSTGRES_PORT=
# REDIS_PORT=

# CUDA backend.
# LLAMA_CONTEXT_SIZE=
# LLAMA_PARALLEL=
# LLAMA_THREADS=

# Public HTTP and shutdown. Docker's grace covers draining, cleanup, and driver teardown.
# GATEWAY_READ_TIMEOUT=
# GATEWAY_READ_HEADER_TIMEOUT=
# GATEWAY_IDLE_TIMEOUT=
# GATEWAY_SHUTDOWN_TIMEOUT=
# GATEWAY_SHUTDOWN_CLEANUP_TIMEOUT=
# GATEWAY_STOP_GRACE_PERIOD=

# Chat and backend deadlines.
# GATEWAY_MAX_BODY_BYTES=
# GATEWAY_MAX_TOKENS=
# GATEWAY_UPSTREAM_TIMEOUT=
# GATEWAY_UPSTREAM_CONNECT_TIMEOUT=
# GATEWAY_UPSTREAM_HEADER_TIMEOUT=
# GATEWAY_STREAM_IDLE_TIMEOUT=
# GATEWAY_READINESS_TIMEOUT=

# Postgres and in-process authentication cache.
# GATEWAY_DATABASE_MAX_CONNS=
# GATEWAY_DATABASE_CONNECT_TIMEOUT=
# GATEWAY_AUTH_LOOKUP_TIMEOUT=
# GATEWAY_AUTH_CACHE_TTL=
# GATEWAY_AUTH_CACHE_CAPACITY=

# Redis and per-key request limits.
# GATEWAY_REDIS_MAX_CONNS=
# GATEWAY_REDIS_CONNECT_TIMEOUT=
# GATEWAY_RATE_LIMIT_TIMEOUT=

# Daily token quotas and final usage recording.
# GATEWAY_QUOTA_GRACE_PERCENT=
# GATEWAY_QUOTA_COUNT_TIMEOUT=
# GATEWAY_QUOTA_COUNT_MAX_BYTES=
# GATEWAY_QUOTA_REDIS_TIMEOUT=
# GATEWAY_USAGE_WRITE_TIMEOUT=
# GATEWAY_USAGE_MAX_BYTES=

# Prometheus metrics.
# GATEWAY_METRICS_KEY_CAPACITY=
# GATEWAY_METRICS_MAX_SCRAPES=
# GATEWAY_METRICS_SCRAPE_TIMEOUT=

# Optional admin API, reachable only within the gateway container.
# GATEWAY_ADMIN_ENABLED=
# GATEWAY_ADMIN_TOKEN=
# GATEWAY_ADMIN_MAX_BODY_BYTES=
# GATEWAY_ADMIN_CREATE_TIMEOUT=
# GATEWAY_ADMIN_REVOKE_TIMEOUT=
